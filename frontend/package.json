{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.7.0",
    "@testing-library/react": "^16.3.0",
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "ajv-keywords": "^5.1.0",
    "axios": "^1.11.0",
    "date-fns": "^3.0.0",
    "highlight.js": "^11.11.1",
    "react": "^19.1.1",
    "react-datepicker": "^7.0.0",
    "react-dom": "^19.1.1",
    "react-resizable-panels": "^2.0.20",
    "react-router-dom": "^7.8.1",
    "react-simple-code-editor": "^0.14.1",
    "recharts": "^3.10.1",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/preset-env": "^8.0.6",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-jest": "^30.5.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.0.0",
    "eslint-import-resolver-typescript": "^3.8.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "^3.0.0",
    "typescript": "5.5.4",
    "vite": "^8.3.1"
  },
  "scripts": {
    "start": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "jest",
    "test:ci": "jest --watchAll=false --coverage",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "type-check": "tsc --noEmit",
    "type-check:tests:services": "tsc -p tsconfig.tests.services.json --noEmit",
    "lint": "eslint src --ext .ts,.tsx --fix",
    "lint:check": "eslint src --ext .ts,.tsx",
    "format": "prettier --write src/**/*.{ts,tsx,css}",
    "format:check": "prettier --check src/**/*.{ts,tsx,css}",
    "validate": "npm run type-check && npm run lint:check && npm run test:ci",
    "type-check:tests:hooks": "tsc -p tsconfig.tests.hooks.json --noEmit",
    "type-check:tests:all": "tsc -p tsconfig.tests.all.json --noEmit"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/src/setupTests.ts"
    ],
    "transform": {
      "^.+\\.[jt]sx?$": "babel-jest"
    },
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^.+\\.(css|sass|scss)$": "identity-obj-proxy",
      "^react-router-dom$": "<rootDir>/node_modules/react-router-dom/dist/index.js",
      "^react-router/dom$": "<rootDir>/node_modules/react-router/dist/development/dom-export.js",
      "^@phosphor-icons/react$": "<rootDir>/node_modules/@phosphor-icons/react/dist/index.es.js"
    },
    "transformIgnorePatterns": [
      "[/\\\\]node_modules[/\\\\](?!axios|react-router-dom|@remix-run|turbo-stream|@phosphor-icons).+\\.(js|jsx|mjs|cjs|ts|tsx)$"
    ],
    "resetMocks": true,
    "collectCoverageFrom": [
      "src/services/*.ts",
      "!src/services/api.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 85,
        "lines": 90
      }
    }
  }
}
