{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": "26.x"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.7.0",
    "@testing-library/react": "^16.3.0",
    "@oj/statement-renderer": "file:../shared/statement-renderer",
    "@types/node": "^26.6.6",
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "ajv-keywords": "^5.1.0",
    "axios": "^1.11.0",
    "date-fns": "^3.0.0",
    "highlight.js": "^11.11.1",
    "react": "^19.1.1",
    "react-datepicker": "^7.0.0",
    "react-dom": "^19.1.1",
    "react-resizable-panels": "^2.0.20",
    "react-router-dom": "^7.8.1",
    "react-simple-code-editor": "^0.14.1",
    "recharts": "^3.10.1",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.29.14",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "babel-jest": "^30.5.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "^3.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "whatwg-fetch": "^3.6.20"
  },
  "scripts": {
    "start": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-no-inline-scripts.mjs",
    "test": "jest --watch",
    "test:ci": "jest --ci --coverage",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "type-check": "tsc --noEmit",
    "type-check:tests:services": "tsc -p tsconfig.tests.services.json --noEmit",
    "lint": "eslint src --fix",
    "lint:check": "eslint src",
    "format": "prettier --write src/**/*.{ts,tsx,css}",
    "format:check": "prettier --check src/**/*.{ts,tsx,css}",
    "validate": "npm run type-check && npm run lint:check && npm run test:ci",
    "type-check:tests:hooks": "tsc -p tsconfig.tests.hooks.json --noEmit",
    "type-check:tests:all": "tsc -p tsconfig.tests.all.json --noEmit"
  }
}
